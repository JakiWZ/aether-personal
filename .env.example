# Copy to .env and adjust. Never commit .env.
# Local-only defaults used by infrastructure/docker-compose.yml and the backend.
AETHER_DB_NAME=aether
AETHER_DB_USER=aether
AETHER_DB_PASSWORD=aether
AETHER_DB_PORT=5432
# Mark the session and CSRF cookies Secure; set to true wherever the app is served over HTTPS.
AETHER_COOKIE_SECURE=false
# Publish /v3/api-docs and Swagger UI outside the dev profile (keep false in shared environments).
AETHER_API_DOCS_ENABLED=false
# Log format: empty for readable text (local), `ecs` for one JSON object per line in shared environments.
AETHER_LOG_FORMAT=
